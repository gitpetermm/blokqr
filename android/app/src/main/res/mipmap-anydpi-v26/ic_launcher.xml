<?xml version="1.0" encoding="utf-8"?>
<!-- Icone adaptative BlokQR : trois calques (fond + premier plan + monochrome).
     Le lanceur applique lui-meme la forme (ronde, carree, goutte) et rogne les
     bords : le contenu important du premier plan tient dans le cercle de securite.
     Le calque <monochrome> alimente les ICONES THEMATIQUES (Android 13+) : le
     systeme recolore alors cette silhouette selon le fond d'ecran de l'utilisateur. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
