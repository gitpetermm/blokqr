<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Caméra : indispensable au scan. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Internet : UNIQUEMENT pour contacter le service BlokQR (jamais la cible). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Enregistrement des fichiers téléchargés (Android 9 et moins uniquement). -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Notifications d'analyse en arrière-plan (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Localisation : UNIQUEMENT pour le bouton « Ma position actuelle » de
         l'onglet Créer (remplit lat/lng). Les coordonnées restent sur
         l'appareil et ne sont jamais transmises. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.camera.any" android:required="true" />
    <!-- La localisation est optionnelle (le scan/génération fonctionnent sans). -->
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <application
        android:name=".BlokQrApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.BlokQr"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.BlokQr.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Partage entrant : « Partager -> BlokQR » pour analyser un lien
                 reçu d'une autre app (messagerie, e-mail, navigateur...). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Raccourcis (appui long sur l'icône) : Scanner / Créer. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <!-- Bac à sable WebView isolé dans un PROCESS SÉPARÉ (:sandbox).
             Le moteur de rendu est déjà sandboxé par Android ; on isole en plus
             l'hôte WebView dans un process distinct qui ne détient AUCUN secret.
             exported=false : lancé uniquement en interne, jamais par un tiers. -->
        <activity
            android:name=".ui.sandbox.SandboxActivity"
            android:process=":sandbox"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode"
            android:theme="@style/Theme.BlokQr" />
        <!-- FileProvider : content:// Uri pour OUVRIR un fichier téléchargé
             (Android 9 et moins). Autorité = packageName + ".downloads.fileprovider". -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.downloads.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- Tuile « Réglages rapides » : scan sûr en un tap depuis le volet.
             exported=true + permission système BIND_QUICK_SETTINGS_TILE. -->
        <service
            android:name=".widget.ScanTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_scan"
            android:label="@string/tile_scan_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- Widget d'écran d'accueil : Scanner / Vérifier un lien. -->
        <receiver
            android:name=".widget.ScanWidgetProvider"
            android:exported="false"
            android:label="@string/widget_picker_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/scan_widget_info" />
        </receiver>
    </application>
</manifest>