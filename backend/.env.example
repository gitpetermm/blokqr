# --- Environnement -----------------------------------------------------------
ENVIRONMENT=production
DEBUG=false

# --- Réseau ------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
# Restreindre en production aux origines réellement nécessaires.
CORS_ALLOWED_ORIGINS=["https://votre-app.example"]
RATE_LIMIT_PER_MINUTE=30

# --- Résolution / sandbox ----------------------------------------------------
MAX_REDIRECT_HOPS=15
HTTP_TIMEOUT_SECONDS=8
ENABLE_DYNAMIC_SANDBOX=true
DYNAMIC_TIMEOUT_SECONDS=15

# --- Protection SSRF ---------------------------------------------------------
BLOCK_PRIVATE_NETWORKS=true

# --- Threat Intelligence (laisser vide pour désactiver une source) -----------
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
URLSCAN_API_KEY=
ENABLE_PHISHTANK=true
ENABLE_URLHAUS=true
THREAT_INTEL_TIMEOUT_SECONDS=10

# --- Signature des verdicts --------------------------------------------------
# Générer avec : python scripts/generate_keys.py
VERDICT_SIGNING_SEED_B64=
ENABLE_PQ_SIGNATURE=true

# --- Seuils de notation ------------------------------------------------------
SCORE_THRESHOLD_SUSPICIOUS=35
SCORE_THRESHOLD_DANGEROUS=70

# --- v3 : racine de confiance post-quantique & durcissement ---
SPHINCS_ROOT_KEY_PATH=keys/slhdsa_root.json   # racine SLH-DSA (HSM/KMS en prod)
ENABLE_PQ_ENVELOPE=true                        # enveloppe ML-KEM des requêtes
VERDICT_TTL_SECONDS=120                         # fraîcheur du verdict (anti-rejeu)
FAIL_CLOSED=true                                # analyse incomplète => Unknown
EGRESS_PROXY_URL=                               # proxy sortie bac à sable (résidentiel)
SANDBOX_DISABLE_CHROMIUM_SANDBOX=false          # NE PAS activer hors env. contraint
ALWAYS_DUAL_PROFILE=false                        # sinon escalade si suspicion
THREAT_FEED_PATH=                                # flux réputation additionnel (URLhaus...)
