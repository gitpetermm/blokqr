    <string name="onb1_title">Welcome to BlokQR</string>
        <string name="onb1_body">QR codes, barcodes, links, Wi-Fi networks: BlokQR checks every destination before you open it.</string>
    <string name="onb2_title">The link is never opened on your phone</string>
    <string name="onb2_body">The code is decoded locally, then its destination is analyzed remotely — without ever loading the page on your device.</string>
    <string name="onb3_title">We follow the redirects</string>
    <string name="onb3_body">BlokQR follows the redirect chain to the final destination and detects phishing, malware and impersonation pages.</string>
    <string name="onb4_title">Signed and authenticated verdict</string>
    <string name="onb4_body">Every verdict is signed (classic + post-quantum): you know it really comes from BlokQR and hasn\'t been tampered with.</string>
        <string name="onb5_title">Protected even offline</string>
        <string name="onb5_body">A signed threat list is bundled in the app and updated every day. Offline, BlokQR blocks known malicious domains and stays usable.</string>
    <string name="onb6_title">Upgrade to BlokQR Pro</string>
    <string name="onb6_body">The free version gives you 7 verified scans per day. Go Pro for unlimited scans* and in-depth analysis of the most sensitive links.</string>
    <string name="onb6_trial">14-day free trial</string>
    <string name="about_section_more">More</string>
